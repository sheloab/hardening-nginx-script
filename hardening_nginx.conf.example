# ============================================================
#  hardening_nginx.conf  — configuration for hardening_nginx_v5.sh
#
#  Copy this file to hardening_nginx.conf and edit the values,
#  then run:  sudo ./hardening_nginx_v5.sh hardening_nginx.conf
#
#  If NON_INTERACTIVE=no the script will prompt, using the
#  values below as the defaults.
# ============================================================

# Run without any prompts (yes) or ask interactively (no).
NON_INTERACTIVE=yes

# Primary domain used in the example server block and log paths.
DOMAIN="example.com"

# Strict Content-Security-Policy. "yes" blocks inline scripts/styles
# (safest, but can break apps that rely on them). "no" is permissive.
STRICT_CSP=no

# Add "preload" to the HSTS header. Only enable when the site and ALL
# subdomains are HTTPS-only, and you intend to submit to hstspreload.org.
HSTS_PRELOAD=no

# HSTS max-age in seconds (31536000 = 1 year).
HSTS_MAX_AGE=31536000

# Install nginx automatically if it is not present.
INSTALL_NGINX_IF_MISSING=yes

# Install nginx-extras to enable more_clear_headers (hides the Server header).
INSTALL_HEADERS_MORE=yes

# Generate Diffie-Hellman parameters for stronger DHE ciphers.
GENERATE_DHPARAM=yes
DHPARAM_BITS=2048

# Write rate-limiting zones (limit_req_zone / limit_conn_zone) into
# hardening.conf. Set to "no" if you already define these elsewhere.
ENABLE_RATE_LIMIT=yes

# Maximum request body size (uploads).
CLIENT_MAX_BODY_SIZE=100m

# DNS resolvers used for OCSP stapling in server blocks.
RESOLVERS="1.1.1.1 1.0.0.1 valid=300s"

# Write a disabled example server block to conf.d for reference.
CREATE_EXAMPLE_SERVER=yes

# ── BOT & SCANNER BLOCKER ────────────────────────────────────
# Drop scanners, scripts (curl, python-requests, ...), empty user-agents
# and unknown bots with 444 (no answer). A site is protected once its
# server{} block contains:  include /etc/nginx/snippets/bot-response.conf;
ENABLE_BOT_BLOCKER=yes

# Also drop AI-training crawlers and SEO scrapers (GPTBot, CCBot, Ahrefs...).
BLOCK_AI_CRAWLERS=yes

# Also drop search engines and link previews (Google, Bing, Slack...).
# Only for private sites that must not be indexed.
BLOCK_SEARCH_ENGINES=no

# Add the include line to every server{} block in sites-enabled now.
# Undone automatically if the new config fails nginx -t.
BOT_AUTO_INCLUDE=no

# Ban the IPs of dropped bots, honeypot hits and hidden-file probes
# (/.env, /.git/...) with fail2ban. Bans are enforced inside nginx.
ENABLE_FAIL2BAN=yes
INSTALL_FAIL2BAN=yes

# Ban length in seconds (604800 = 7 days).
BAN_TIME=604800

# Your own addresses: never dropped, logged or banned (space-separated,
# IPs or CIDR ranges). 127.0.0.1 and ::1 are always included.
BAN_IGNORE_IPS=""

# The site is behind Cloudflare's proxy: take the visitor's address from
# CF-Connecting-IP and never ban Cloudflare's own addresses.
BEHIND_CLOUDFLARE=no
